   "source": [
    "# Joining all datasets into a DataFrame\n",
    "df = (order_details.merge(orders, on='order_id').merge(pizzas, on='pizza_id').merge(pizza_types,  on='pizza_type_id'))\n",
    "\n",
    "#columns\n",
    "df['revenue']    = df['quantity'] * df['price']\n",
    "df['hour']       = pd.to_datetime(df['time'].astype(str)).dt.hour\n",
    "df['day_of_week']= df['date'].dt.day_name()\n",
    "df['month']      = df['date'].dt.month\n",
    "df['month_name'] = df['date'].dt.strftime('%B')\n",
    "\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2a32c5bf",
   "metadata": {},
   "source": [
    "## Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "353317b1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total Revenue       : $817,860.05\n",
      "Total Qty Sold      : 49,574\n",
      "Total Orders        : 21,350\n",
      "Pizza Types         : 32\n",
      "Avg Pizza Price     : $16.44\n"
     ]
    }
   ],
   "source": [
    "total_revenue   = df['revenue'].sum()\n",
    "total_qty       = df['quantity'].sum()\n",
    "total_orders    = orders['order_id'].nunique()\n",
    "num_pizza_types = pizza_types['pizza_type_id'].nunique()\n",
    "avg_price       = pizzas['price'].mean()\n",
    "\n",
    "metrics = {\n",
    "    'Total Revenue':    f'${total_revenue:,.2f}',\n",
    "    'Total Qty Sold':   f'{total_qty:,}',\n",
    "    'Total Orders':     f'{total_orders:,}',\n",
    "    'Pizza Types':      f'{num_pizza_types}',\n",
    "    'Avg Pizza Price':  f'${avg_price:.2f}',\n",
    "}\n",
    "\n",
    "for k, v in metrics.items():\n",
    "    print(f'{k:20s}: {v}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e99b39a8",
   "metadata": {},
   "source": [
    "#### Key Metrics\n",
    "1. The pizza place generated $817,860.05 in revenue\n",
    "2. 49,574 pizzas were sold\n",
    "3. A total of 21,350 orders \n",
    "4. The pizza place sold 32 types of pizzas\n",
    "5. The average cost of pizza was $16.44"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f9d792ec",
   "metadata": {},
   "source": [
    "Peak Hours of Sales"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "f82e1bc8",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "hourly = df.groupby('hour').agg(orders=('order_id','nunique'), revenue=('revenue','sum')).reset_index()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2,)\n",
    "\n",
    "axes[0].bar(hourly['hour'], hourly['orders'])\n",
    "axes[0].set_title('Orders by Hour of Day')\n",
    "axes[0].set_xlabel('Hour')\n",
    "axes[0].set_ylabel('Number of Orders')\n",
    "axes[0].set_xticks(hourly['hour'])\n",
    "\n",
    "axes[1].bar(hourly['hour'], hourly['revenue'])\n",
    "axes[1].set_title('Revenue by Hour of Day',)\n",
    "axes[1].set_xlabel('Hour')\n",
    "axes[1].set_ylabel('Revenue ($)')\n",
    "axes[1].set_xticks(hourly['hour'])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('peak_hours.png')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bed46711",
   "metadata": {},
   "source": [
    "6. 12pm and 1pm consecutively aere the peak hours in the afternoo while 5pm and 6pm are the peak hours in the evening\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "291a5878",
   "metadata": {},
   "source": [
    "## Sales by Day of the Week"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "9e2b59b9",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "day_order = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']\n",
    "daily = (df.groupby('day_of_week')\n",
    "           .agg(revenue=('revenue','sum'), orders=('order_id','nunique'))\n",
    "           .reindex(day_order)\n",
    "           .reset_index())\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "bars = ax.bar(daily['day_of_week'], daily['revenue'])\n",
    "ax.set_title('Total Revenue by Day of the Week')\n",
    "ax.set_xlabel('Day')\n",
    "ax.set_ylabel('Revenue ($)')\n",
    "ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x,_: f'${x:,.0f}'))\n",
    "for bar in bars:\n",
    "    ax.text(bar.get_x()+bar.get_width()/2, bar.get_height()+500, f'${bar.get_height():,.0f}', ha='center', va='bottom')\n",
    "plt.tight_layout()\n",
    "plt.savefig('daily_sales.png')\n",
    "plt.show()\n",
    "\n"
   ]
  },
  {
