   "source": [
    "## Monthly Sales Trend"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "f907cc46",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
