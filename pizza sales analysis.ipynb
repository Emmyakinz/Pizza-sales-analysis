   "source": [
    "## Bestselling Pizzas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "4069228a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x500 with 2 Axes>"
      ]
